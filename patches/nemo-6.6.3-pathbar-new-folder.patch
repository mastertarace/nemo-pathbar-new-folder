+static void
+action_location_new_folder_callback (GtkAction *action,
+				     gpointer   callback_data)
+{
+	NemoView *view;
+	NemoFile *file;
+	GtkWidget *dialog, *entry, *content;
+	GFile *parent, *child;
+	GError *error;
+	const char *name;
+
+	view = NEMO_VIEW (callback_data);
+
+	file = view->details->location_popup_directory_as_file;
+	g_return_if_fail (file != NULL);
+
+	dialog = gtk_dialog_new_with_buttons (_("New folder"),
+					      nemo_view_get_containing_window (view),
+					      GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+					      _("_Cancel"), GTK_RESPONSE_CANCEL,
+					      _("Create New _Folder"), GTK_RESPONSE_OK,
+					      NULL);
+	gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+	entry = gtk_entry_new ();
+	gtk_entry_set_text (GTK_ENTRY (entry), _("Untitled Folder"));
+	gtk_entry_set_activates_default (GTK_ENTRY (entry), TRUE);
+	gtk_entry_set_width_chars (GTK_ENTRY (entry), 40);
+
+	content = gtk_dialog_get_content_area (GTK_DIALOG (dialog));
+	gtk_container_set_border_width (GTK_CONTAINER (content), 12);
+	gtk_box_pack_start (GTK_BOX (content), entry, TRUE, TRUE, 0);
+	gtk_widget_show_all (dialog);
+
+	if (gtk_dialog_run (GTK_DIALOG (dialog)) == GTK_RESPONSE_OK) {
+		name = gtk_entry_get_text (GTK_ENTRY (entry));
+		if (name[0] != '\0') {
+			parent = nemo_file_get_location (file);
+			child = g_file_get_child_for_display_name (parent, name, NULL);
+			error = NULL;
+			if (child == NULL ||
+			    !g_file_make_directory (child, NULL, &error)) {
+				eel_show_error_dialog (_("New folder"),
+						       error != NULL ? error->message : name,
+						       nemo_view_get_containing_window (view));
+				g_clear_error (&error);
+			}
+			g_clear_object (&child);
+			g_object_unref (parent);
+		}
+	}
+
+	gtk_widget_destroy (dialog);
+}
